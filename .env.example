# OneChat environment. Copy to .env.local and fill in what you have.
# Any provider without a key is skipped automatically, and the app still runs on the rest.

# Model lists: the picker offers exactly these, per provider. Replace a list with
# `${PROVIDER}_MODELS` (comma separated), or promote one model with `${PROVIDER}_DEFAULT_MODEL`
# (the older `${PROVIDER}_MODEL` still works) - a bypass that also works for a model not listed.

# --- OpenAI (primary tier: this traffic is shared with OpenAI and may be used for training) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.4-nano
# optional: point at a proxy or a compatible gateway
OPENAI_BASE_URL=

# --- Google Gemini (paid key: no training on your data; this is the ONLY tier privacy mode uses) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# optional extra Gemini model appended to the chain
GEMINI_FALLBACK_MODEL=
GEMINI_BASE_URL=

# --- NVIDIA NIM (third tier) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=

# --- Groq (last tier) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# --- App ---
# If set, the whole app is behind this single password. Leave empty for no login.
APP_PASSWORD=

# --- Model lists (optional) ---
#OPENAI_MODELS=gpt-5.4-mini,gpt-5.4,gpt-4.1-mini
#GEMINI_MODELS=gemini-flash-latest,gemini-2.5-pro
#NVIDIA_MODELS=meta/llama-3.3-70b-instruct,deepseek-ai/deepseek-r1
#GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
#GEMINI_DEFAULT_MODEL=gemini-2.5-pro
